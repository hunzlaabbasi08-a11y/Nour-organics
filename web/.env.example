# Public API base URL (no trailing slash). Must include /api if that is your API prefix.
#
# Local dev: leave empty — Vite proxies /api → http://127.0.0.1:3001
# Same-domain production (Nginx proxies /api → Node): leave empty
# Separate API host example:
#   VITE_API_URL=https://api.yourdomain.com/api
VITE_API_URL=
