# Neon PostgreSQL connection string (required).
# Dashboard → your project → Connect → copy the URI.
# Use the pooled host (contains -pooler) if you hit connection limits.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

PORT=3001
JWT_SECRET=change-this-to-a-long-random-string
ADMIN_EMAIL=admin@nourorganics.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=Nour Admin
